# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Raw dataset + prepared cache (regenerated by scripts/prepare_data.py from data/raw/NF-UQ-NIDS.csv)
/data/

# Model binaries and large per-row prediction arrays (regenerable by re-running/re-evaluating a run;
# tracked results are the small CSV/JSON summaries, not these).
*.keras
*.joblib
*.h5
**/checkpoints/
**/model/
known_test_predictions.npy
known_test_probabilities.npy
zero_day_predictions.npy
zero_day_probabilities.npy

# Sweep runtime state + raw per-cell run dirs (regenerated by re-running the
# sweep; on disk at experiments/MULTISEED/runs/ regardless of git). The small
# DERIVED artifacts that matter for the paper — aggregate_results.csv,
# summary_stats.csv, significance_tests.csv, per_family_*.csv/json,
# table_main.tex — are tracked normally and committed as explicit snapshots.
experiments/MULTISEED/sweep.pid
experiments/MULTISEED/sweep_stdout.log
experiments/MULTISEED/sweep_stderr.log
experiments/MULTISEED/watchdog.log
experiments/MULTISEED/sweep_log.jsonl
experiments/MULTISEED/progress.log
experiments/MULTISEED/runs/

